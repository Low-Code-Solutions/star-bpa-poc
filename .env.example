# Copy to .env (gitignored). Synthetic-data POC only: do not reuse these values anywhere real.

# Pinned versions (one patch release for every Camunda component)
CAMUNDA_VERSION=8.10.1
CAMUNDA_CONNECTORS_VERSION=8.10.1
POSTGRES_VERSION=17
WIREMOCK_VERSION=3.9.1

# PostgreSQL server (one server, two databases: camunda, bpa)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Camunda secondary storage database
CAMUNDA_DB_NAME=camunda
CAMUNDA_DB_USER=camunda
CAMUNDA_DB_PASSWORD=camunda

# bpa schema database (used by the Spring Boot app later)
BPA_DB_NAME=bpa
BPA_DB_USER=bpa
BPA_DB_PASSWORD=bpa

# Camunda identities (ADR 0005, S22, S25). Placeholders only: real values go in .env, which is never committed.
# Admin used only by the S22 persona-sync job (profile local or showcase); S29 keeps demo/demo.
CAMUNDA_ADMIN_USER=demo
CAMUNDA_ADMIN_PASSWORD=demo
# Technical user created by the S22 job, and the password shared by the persona users (never put in personas.yaml).
BPA_SERVICE_PASSWORD=change-me-service
DEMO_PASSWORD=change-me-demo


# QA only (BPA-81): set the business date ("Given today is ... (Asia/Riyadh)") for a running stack. Needs the qa profile, which only does this.
# Keep local in the list: the persona sync needs it. The clock keeps moving from that date (an offset set once at start-up, whole days, the time of
# day is kept); the date rolls on after midnight in app.business-zone. Changing the date means restarting bpa-app: docker compose up -d bpa-app
# The portal's own date checks use the browser's date, not this one (BPA-81 plan, risks). Without qa a set BPA_CLOCK_TODAY is ignored with a WARN.
# A BPA_PROFILES or BPA_CLOCK_TODAY set in your shell overrides .env (compose precedence); BPA_PROFILES=qa alone drops local and the logins stop working.
# BPA_PROFILES=local,qa
# BPA_CLOCK_TODAY=2026-12-01

# BPA-83 (C-E3-3): true lets the Project Manager reopen a Locked progress week with a reason (a demo setting). The default is false: a Locked week never changes,
# and a correction goes through a retraction in a later week (BPA-63). Changing it means restarting bpa-app: docker compose up -d bpa-app
# BPA_PROGRESS_ALLOW_REOPEN=false
