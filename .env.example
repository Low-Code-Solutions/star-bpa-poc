# Copy to .env (gitignored). Synthetic-data POC only: do not reuse these values anywhere real.

# Pinned versions (one patch release for every Camunda component)
CAMUNDA_VERSION=8.10.1
CAMUNDA_CONNECTORS_VERSION=8.10.1
POSTGRES_VERSION=17
WIREMOCK_VERSION=3.9.1

# PostgreSQL server (one server, two databases: camunda, bpa)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Camunda secondary storage database
CAMUNDA_DB_NAME=camunda
CAMUNDA_DB_USER=camunda
CAMUNDA_DB_PASSWORD=camunda

# bpa schema database (used by the Spring Boot app later)
BPA_DB_NAME=bpa
BPA_DB_USER=bpa
BPA_DB_PASSWORD=bpa

# Camunda identities (ADR 0005, S22, S25). Placeholders only: real values go in .env, which is never committed.
# Admin used by the S22 persona-sync job (and by the app until bpa-service exists); S29 keeps demo/demo.
CAMUNDA_ADMIN_USER=demo
CAMUNDA_ADMIN_PASSWORD=demo
# Technical user created by the S22 job, and the password shared by the persona users (never put in personas.yaml).
BPA_SERVICE_PASSWORD=change-me-service
DEMO_PASSWORD=change-me-demo

