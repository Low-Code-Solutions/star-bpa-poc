{
  "name": "star-bpa-portal",
  "private": true,
  "version": "0.1.0",
  "description": "STAR BPA POC React portal (ADR 0004). Walking skeleton: login, /me, logout (BPA-43).",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run gen:api",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
