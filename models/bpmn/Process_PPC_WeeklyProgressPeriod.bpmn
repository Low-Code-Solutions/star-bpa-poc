<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_WeeklyProgressPeriod" targetNamespace="http://lowcodesol.com/star-bpa-poc" exporter="LCS generator (Claude)" exporterVersion="0.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.1">
  <bpmn:collaboration id="Collaboration_WeeklyProgressPeriod">
    <bpmn:participant id="Participant_PPC_WeeklyProgressPeriod" name="Weekly Progress Period (Epic 2), one instance per week" processRef="Process_PPC_WeeklyProgressPeriod" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PPC_WeeklyProgressPeriod" name="Weekly Progress Period" isExecutable="true">
    <bpmn:documentation>Epic 2 (BPA-4). One instance per reporting week, started at the weekly cut-off. FMS hours export, FMS completion report, completion % approval, progress rule, Earned man-hours, Work Pack completion, variance alerts, Cost Controller review, period lock. DRAFT 10 Nov 2026, not reviewed.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_WeeklyProgressPeriod">
      <bpmn:lane id="Lane_PpcTeam" name="PPC Team">
        <bpmn:flowNodeRef>UserTask_SendHoursToFms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_UploadCompletionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ApproveCompletion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProjectManager" name="Project Manager">
        <bpmn:flowNodeRef>UserTask_ApproveRetraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ApproveWeeklyProgress</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CostController" name="Cost Controller">
        <bpmn:flowNodeRef>Gateway_MergeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReviewActualManhours</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System (POC workers)">
        <bpmn:flowNodeRef>StartEvent_WeeklyCutOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OpenProgressPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_GenerateFmsHoursFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordFmsHandOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ReadCompletionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeProgressCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordCompletionApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepareProgressCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BusinessRuleTask_CheckProgressRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordProgressResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProgressOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordRetractionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsRetractionApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CalculateEarnedManhours</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CompleteWorkPacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepareVarianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BusinessRuleTask_CheckManhourVariance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BusinessRuleTask_CheckCostVariance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendVarianceAlerts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordCbsReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsWeekApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_LockProgressPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PeriodLocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_ReportInvalid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_WeeklyCutOff" name="Weekly cut-off">
      <bpmn:documentation>E2-16. Thursday 23:59 Asia/Riyadh = 20:59 UTC (ASSUMPTION: no source names the day; FRD-21 §21.9.1 fixes the period by the cut-off date). Zeebe cron, UTC.</bpmn:documentation>
      <bpmn:outgoing>Flow_ToOpenPeriod</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_WeeklyCutOff">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 59 20 * * THU</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_OpenProgressPeriod" name="Open progress period">
      <bpmn:documentation>E2-16. Creates progress_period (week_ending = cut-off date, status CutOff); from now on hours dated on or before week_ending cannot be added or changed. Outputs progressPeriodId, weekEnding. Re-run key: process instance key.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="open-progress-period" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToOpenPeriod</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGenerateFmsFile</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_GenerateFmsHoursFile" name="Generate FMS hours file">
      <bpmn:documentation>E2-08. Approved lines not yet exported -&gt; Excel in the FRD-10-1 §10.1.3.3 layout (Type, Date, Badge No., Employment Type, Project, Activity, Cost Centre, CBS, CBS Cost Centre, Hrs; Employment Type is Direct or Agency from worker.agency_flag, S2); one file per calendar month of the work dates (S5); stored in fms_hours_export; lines stamped exported. Re-run key: progressPeriodId (BPA-58). Output fmsHoursExports. Batch/file, partner-side (project rule).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-fms-hours-file" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGenerateFmsFile</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendHoursToFms</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_SendHoursToFms" name="Send hours to FMS">
      <bpmn:documentation>E2-08. PPC downloads the file (GET /api/v1/fms-hours-exports/{id}/file) and uploads it to FMS by hand (MOM-2026-10-01: ERP Excel download as the alternative to manual FMS upload). Completing the task gives one outcome per file (Sent to FMS, or Rejected by FMS with a reason); ServiceTask_RecordFmsHandOff records them (BPA-58).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="ppc-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendHoursToFms</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordHandOff</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_RecordFmsHandOff" name="Record FMS hand-off">
      <bpmn:documentation>E2-08 (BPA-58, plan Q7). Reads fmsHandOffs (one entry per file: fmsHoursExportId, outcome, reason). Sent to FMS: sent_by = completedBy, sent_at. Rejected by FMS: fms_rejected_at and fms_rejected_reason, the file's lines are released (exported_at and fms_hours_export_id cleared), the file is kept (S4). Re-run key: a file that already has sent_at or fms_rejected_at is left as it is.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-fms-hand-off" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordHandOff</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeReport</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeReport" name="Merge">
      <bpmn:documentation>E2-09.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeReport</bpmn:incoming>
      <bpmn:incoming>Flow_ReportInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUploadReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_UploadCompletionReport" name="Upload FMS completion report">
      <bpmn:documentation>E2-09. Upload through POST /api/v1/completion-reports (FRD-21 §21.6 step 4; FRD-22 §22.6.2 step 5). Task output completionReportId.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="ppc-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUploadReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReadReport</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_ReadCompletionReport" name="Read completion report">
      <bpmn:documentation>E2-09. Parses rows (Workpack number, completion %, actual hours), logs each row with an outcome. Throws REPORT_INVALID with validationMessages when nothing usable.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="read-completion-report" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReadReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeApproval</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeApproval" name="Merge">
      <bpmn:documentation>E2-10.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeApproval</bpmn:incoming>
      <bpmn:incoming>Flow_ProgressBlocked</bpmn:incoming>
      <bpmn:incoming>Flow_RetractionDeclined</bpmn:incoming>
      <bpmn:incoming>Flow_WeekChangesRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApproveCompletion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ApproveCompletion" name="Approve completion %">
      <bpmn:documentation>E2-10. FRD-21 §21.6 steps 3-4: PPC approves the Work Pack physical completion %. May ask for a retraction (reason required) where a % goes down.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="ppc-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApproveCompletion</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_RecordCompletionApproval" name="Record completion approval">
      <bpmn:documentation>E2-10 (BPA-60, plan Q7). Reads completionApprovals (one entry per Work Pack: workpackNumber, approvedPct, remark) and writes workpack_progress for the week: approved_pct, override_remark (empty when the approved % equals the reported %), previous_pct (the last locked %), approved_by = completedBy, approved_at. All or nothing for the week. Re-run key: the values themselves (a row that already holds them is left as it is and keeps approved_at); a Locked week is refused (job fails, no retries).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-completion-approval" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeProgressCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeProgressCheck" name="Merge">
      <bpmn:documentation>E2-11, E2-12.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeProgressCheck</bpmn:incoming>
      <bpmn:incoming>Flow_RetractionApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPrepareProgressCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_PrepareProgressCheck" name="Prepare progress check">
      <bpmn:documentation>E2-11. Builds progressChecks (one per Work Pack: workpackNumber, newPct, previousPct, retractionApproved).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-progress-check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrepareProgressCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckProgressRule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_CheckProgressRule" name="Check progress rule">
      <bpmn:documentation>E2-11. Decision_ProgressRule per Work Pack (FIRST). FRD-21 §21.9.1. BPA-61: the decision reads newPct, previousPct and retractionApproved, so each pass maps them from its progressCheck (without the mapping every Work Pack came out Accepted), and each result keeps its Work Pack for ServiceTask_RecordProgressResult.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=progressCheck.newPct" target="newPct" />
          <zeebe:input source="=progressCheck.previousPct" target="previousPct" />
          <zeebe:input source="=progressCheck.retractionApproved" target="retractionApproved" />
        </zeebe:ioMapping>
        <zeebe:calledDecision decisionId="Decision_ProgressRule" resultVariable="progressRuleResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckProgressRule</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordProgressResult</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=progressChecks" inputElement="progressCheck" outputCollection="progressCheckResults" outputElement="={workpackNumber: progressCheck.workpackNumber, newPct: progressCheck.newPct, previousPct: progressCheck.previousPct, progressResult: progressRuleResult.progressResult, progressReason: progressRuleResult.progressReason}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="ServiceTask_RecordProgressResult" name="Record progress result">
      <bpmn:documentation>E2-11 (BPA-61, plan Q3 b). Reads progressCheckResults (workpackNumber, newPct, previousPct, progressResult, progressReason) and writes workpack_progress.rule_result for the week (Accepted, Blocked, NeedsRetraction) in one transaction; sets validationMessages, one per Work Pack that is not Accepted: ABOVE_100 "&lt;WP&gt; completion cannot exceed 100% (approved &lt;n&gt;%)", BELOW_0 "&lt;WP&gt; completion cannot be below 0%", DECREASE "&lt;WP&gt; completion fell from &lt;prev&gt;% to &lt;new&gt;%; a retraction is needed" (empty when all are Accepted, so an old message never shows). Re-run key: the values (the same rule_result written again changes nothing).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-progress-result" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordProgressResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProgressOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ProgressOutcome" name="Progress outcome?" default="Flow_ProgressAccepted">
      <bpmn:documentation>E2-11. Blocked wins over NeedsRetraction; both win over Accepted.</bpmn:documentation>
      <bpmn:incoming>Flow_ToProgressOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ProgressBlocked</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedsRetraction</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProgressAccepted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ApproveRetraction" name="Approve progress retraction">
      <bpmn:documentation>E2-12 (BPA-63). FRD-21 §21.9.1 (decrease only with an approved retraction); §21.7: Project Manager, documented justification. One task lists every Work Pack that waits for a retraction (last locked %, new %, PPC reason); the PM decides each one in retractionDecisions (workpackNumber, retractionDecision Approved or Declined, reason, required when Declined).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="project-manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsRetraction</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordRetraction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_RecordRetractionDecision" name="Record retraction decision">
      <bpmn:documentation>E2-12 (BPA-63). Writes decision, decision_reason, decided_by/at and task_key on each open progress_retraction of the week (one transaction, audited). Sets retractionOutcome: Approved only when every Work Pack is Approved, else Declined (a declined week clears validationMessages). Re-run key: task_key.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-retraction-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordRetraction</bpmn:incoming>
      <bpmn:outgoing>Flow_ToIsRetractionApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_IsRetractionApproved" name="Retraction approved?" default="Flow_RetractionDeclined">
      <bpmn:documentation>E2-12.</bpmn:documentation>
      <bpmn:incoming>Flow_ToIsRetractionApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_RetractionApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_RetractionDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_CalculateEarnedManhours" name="Calculate Earned man-hours">
      <bpmn:documentation>E2-13. Activity % from the approved Work Pack % (roll-up ASSUMPTION, spec); Earned MH = activity % x latest budgeted units (FRD-21 §21.5.2.1 #3, §21.9.1); not editable; stored per week, never overwritten.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-earned-manhours" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProgressAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPrepareVariance</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_CompleteWorkPacks" name="Complete Work Packs">
      <bpmn:documentation>E2-16. Work Packs approved at 100% -&gt; status Completed (FRD-7 status list); publishes WorkPackCompleted (key workpackNumber) to close their time sheet instance.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="complete-workpacks" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WeekApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLockPeriod</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_PrepareVarianceCheck" name="Prepare variance check">
      <bpmn:documentation>E2-14, E2-15. Builds varianceChecks per CBS code: actualManhours (approved hours, POC), currentForecastManhours and revisedBudgetCost (seeded, D365 F&amp;O Cost Control Report), actualCost (seeded, D365 F&amp;O Finance).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-variance-check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrepareVariance</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManhourVariance</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_CheckManhourVariance" name="Check man-hour variance">
      <bpmn:documentation>E2-14. Decision_ManhourVariance per CBS (FRD-22 §22.10: &gt; 15% against Current Forecast). BPA-64: the decision reads currentForecastManhours and actualManhours, so each pass maps them from its varianceCheck (without the mapping every CBS came out NO_FORECAST), and each result keeps its CBS and figures for ServiceTask_SendVarianceAlerts.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=varianceCheck.actualManhours" target="actualManhours" />
          <zeebe:input source="=varianceCheck.currentForecastManhours" target="currentForecastManhours" />
        </zeebe:ioMapping>
        <zeebe:calledDecision decisionId="Decision_ManhourVariance" resultVariable="manhourCheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToManhourVariance</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCostVariance</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=varianceChecks" inputElement="varianceCheck" outputCollection="manhourCheckResults" outputElement="={cbsCodeRef: varianceCheck.cbsCodeRef, actualManhours: varianceCheck.actualManhours, currentForecastManhours: varianceCheck.currentForecastManhours, manhourAlert: manhourCheck.manhourAlert, manhourResult: manhourCheck.manhourResult}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_CheckCostVariance" name="Check cost variance">
      <bpmn:documentation>E2-15. Decision_CostVariance per CBS (FRD-22 §22.10: &gt; 10% against Revised Budget). BPA-64: mapped like the man-hour check (revisedBudgetCost, actualCost from varianceCheck) and each result keeps its CBS; BPA-65 sends the cost alert.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=varianceCheck.revisedBudgetCost" target="revisedBudgetCost" />
          <zeebe:input source="=varianceCheck.actualCost" target="actualCost" />
        </zeebe:ioMapping>
        <zeebe:calledDecision decisionId="Decision_CostVariance" resultVariable="costCheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCostVariance</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendAlerts</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=varianceChecks" inputElement="varianceCheck" outputCollection="costCheckResults" outputElement="={cbsCodeRef: varianceCheck.cbsCodeRef, revisedBudgetCost: varianceCheck.revisedBudgetCost, actualCost: varianceCheck.actualCost, costAlert: costCheck.costAlert, costResult: costCheck.costResult}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="ServiceTask_SendVarianceAlerts" name="Send variance alerts">
      <bpmn:documentation>E2-14, E2-15. Email (Mailpit, 09 S8) and in-system alert per CBS that alerts; man-hour alert to cost-controller (email and in-system) and by email to the PCON Manager address (D3), cost alert (BPA-65) to project-manager. BPA-64 sends the man-hour alert from manhourCheckResults. Idempotent on (period, CBS, alert type, recipient, channel): the variance_alert unique index.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-variance-alerts" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendAlerts</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeReview" name="Merge">
      <bpmn:documentation>E2-19 (b): the PM can send the week back to the Cost Controller.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeReview</bpmn:incoming>
      <bpmn:incoming>Flow_WeekCostReviewRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReviewManhours</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ReviewActualManhours" name="Review actual man-hours">
      <bpmn:documentation>E2-14, E2-15. FRD-22 §22.4: Cost Controller reviews actual vs budget variances, man-hours and cost (cost read-only). Remark required for every CBS with an alert, optional otherwise.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="cost-controller" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReviewManhours</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordCbsReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_RecordCbsReview" name="Record CBS review">
      <bpmn:documentation>E2-14 (BPA-64, plan Q9). Reads cbsReviews (one entry per CBS: cbsCodeRef, remark) and writes cbs_review for the week of the instance's progress period: remark, reviewed_by = completedBy, reviewed_at; one row per CBS, updated when the week comes back from the Project Manager (BPA-66). Re-run key: the (period, CBS) row and its values, so a retried job writes nothing again. A week with no progress period or a Locked week fails the job with no retries.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-cbs-review" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordCbsReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApproveWeek</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_ApproveWeeklyProgress" name="Approve weekly progress">
      <bpmn:documentation>E2-19. FRD-21 §21.7 and FRD-10 §10.10: the Project Manager approves weekly progress / period close; variance beyond tolerance is escalated to the PM. weekDecision Approved | ChangesRequested (reason required) with weekChangeTarget Progress | CostReview (options ASSUMPTION). The PM must not be the PPC user who approved the % (FRD-21 §21.8.1).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="project-manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApproveWeek</bpmn:incoming>
      <bpmn:outgoing>Flow_ToIsWeekApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IsWeekApproved" name="Week approved?" default="Flow_WeekChangesRequested">
      <bpmn:documentation>E2-19.</bpmn:documentation>
      <bpmn:incoming>Flow_ToIsWeekApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_WeekApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_WeekChangesRequested</bpmn:outgoing>
      <bpmn:outgoing>Flow_WeekCostReviewRequested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_LockProgressPeriod" name="Lock progress period">
      <bpmn:documentation>E2-16, E2-19. After the Project Manager approves the week. progress_period status Locked; approved % and Earned MH of the week can no longer change (FRD-21 §21.9.1; reopening is out of scope).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lock-progress-period" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLockPeriod</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPeriodLocked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PeriodLocked" name="Period locked">
      <bpmn:documentation>E2-16.</bpmn:documentation>
      <bpmn:incoming>Flow_ToPeriodLocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_ReportInvalid" name="Report invalid" attachedToRef="ServiceTask_ReadCompletionReport">
      <bpmn:documentation>REPORT_INVALID; variables validationMessages (file unreadable, no rows, layout not recognised).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=validationMessages" target="validationMessages" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ReportInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ReportInvalid" errorRef="Error_ReportInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToOpenPeriod" sourceRef="StartEvent_WeeklyCutOff" targetRef="ServiceTask_OpenProgressPeriod" />
    <bpmn:sequenceFlow id="Flow_ToGenerateFmsFile" sourceRef="ServiceTask_OpenProgressPeriod" targetRef="ServiceTask_GenerateFmsHoursFile" />
    <bpmn:sequenceFlow id="Flow_ToSendHoursToFms" sourceRef="ServiceTask_GenerateFmsHoursFile" targetRef="UserTask_SendHoursToFms" />
    <bpmn:sequenceFlow id="Flow_ToRecordHandOff" sourceRef="UserTask_SendHoursToFms" targetRef="ServiceTask_RecordFmsHandOff" />
    <bpmn:sequenceFlow id="Flow_ToMergeReport" sourceRef="ServiceTask_RecordFmsHandOff" targetRef="Gateway_MergeReport" />
    <bpmn:sequenceFlow id="Flow_ToUploadReport" sourceRef="Gateway_MergeReport" targetRef="UserTask_UploadCompletionReport" />
    <bpmn:sequenceFlow id="Flow_ToReadReport" sourceRef="UserTask_UploadCompletionReport" targetRef="ServiceTask_ReadCompletionReport" />
    <bpmn:sequenceFlow id="Flow_ToMergeApproval" sourceRef="ServiceTask_ReadCompletionReport" targetRef="Gateway_MergeApproval" />
    <bpmn:sequenceFlow id="Flow_ToApproveCompletion" sourceRef="Gateway_MergeApproval" targetRef="UserTask_ApproveCompletion" />
    <bpmn:sequenceFlow id="Flow_ToRecordApproval" sourceRef="UserTask_ApproveCompletion" targetRef="ServiceTask_RecordCompletionApproval" />
    <bpmn:sequenceFlow id="Flow_ToMergeProgressCheck" sourceRef="ServiceTask_RecordCompletionApproval" targetRef="Gateway_MergeProgressCheck" />
    <bpmn:sequenceFlow id="Flow_ToPrepareProgressCheck" sourceRef="Gateway_MergeProgressCheck" targetRef="ServiceTask_PrepareProgressCheck" />
    <bpmn:sequenceFlow id="Flow_ToCheckProgressRule" sourceRef="ServiceTask_PrepareProgressCheck" targetRef="BusinessRuleTask_CheckProgressRule" />
    <bpmn:sequenceFlow id="Flow_ToRecordProgressResult" sourceRef="BusinessRuleTask_CheckProgressRule" targetRef="ServiceTask_RecordProgressResult" />
    <bpmn:sequenceFlow id="Flow_ToProgressOutcome" sourceRef="ServiceTask_RecordProgressResult" targetRef="Gateway_ProgressOutcome" />
    <bpmn:sequenceFlow id="Flow_ProgressBlocked" name="Blocked" sourceRef="Gateway_ProgressOutcome" targetRef="Gateway_MergeApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some r in progressCheckResults satisfies r.progressResult = "Blocked"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedsRetraction" name="Needs retraction" sourceRef="Gateway_ProgressOutcome" targetRef="UserTask_ApproveRetraction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(every r in progressCheckResults satisfies r.progressResult != "Blocked") and (some r in progressCheckResults satisfies r.progressResult = "NeedsRetraction")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ProgressAccepted" name="Accepted" sourceRef="Gateway_ProgressOutcome" targetRef="ServiceTask_CalculateEarnedManhours" />
    <bpmn:sequenceFlow id="Flow_ToRecordRetraction" sourceRef="UserTask_ApproveRetraction" targetRef="ServiceTask_RecordRetractionDecision" />
    <bpmn:sequenceFlow id="Flow_ToIsRetractionApproved" sourceRef="ServiceTask_RecordRetractionDecision" targetRef="Gateway_IsRetractionApproved" />
    <bpmn:sequenceFlow id="Flow_RetractionApproved" name="Approved" sourceRef="Gateway_IsRetractionApproved" targetRef="Gateway_MergeProgressCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retractionOutcome = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RetractionDeclined" name="Declined" sourceRef="Gateway_IsRetractionApproved" targetRef="Gateway_MergeApproval" />
    <bpmn:sequenceFlow id="Flow_ToPrepareVariance" sourceRef="ServiceTask_CalculateEarnedManhours" targetRef="ServiceTask_PrepareVarianceCheck" />
    <bpmn:sequenceFlow id="Flow_ToManhourVariance" sourceRef="ServiceTask_PrepareVarianceCheck" targetRef="BusinessRuleTask_CheckManhourVariance" />
    <bpmn:sequenceFlow id="Flow_ToCostVariance" sourceRef="BusinessRuleTask_CheckManhourVariance" targetRef="BusinessRuleTask_CheckCostVariance" />
    <bpmn:sequenceFlow id="Flow_ToSendAlerts" sourceRef="BusinessRuleTask_CheckCostVariance" targetRef="ServiceTask_SendVarianceAlerts" />
    <bpmn:sequenceFlow id="Flow_ToMergeReview" sourceRef="ServiceTask_SendVarianceAlerts" targetRef="Gateway_MergeReview" />
    <bpmn:sequenceFlow id="Flow_ToReviewManhours" sourceRef="Gateway_MergeReview" targetRef="UserTask_ReviewActualManhours" />
    <bpmn:sequenceFlow id="Flow_ToRecordCbsReview" sourceRef="UserTask_ReviewActualManhours" targetRef="ServiceTask_RecordCbsReview" />
    <bpmn:sequenceFlow id="Flow_ToApproveWeek" sourceRef="ServiceTask_RecordCbsReview" targetRef="UserTask_ApproveWeeklyProgress" />
    <bpmn:sequenceFlow id="Flow_ToIsWeekApproved" sourceRef="UserTask_ApproveWeeklyProgress" targetRef="Gateway_IsWeekApproved" />
    <bpmn:sequenceFlow id="Flow_WeekApproved" name="Approved" sourceRef="Gateway_IsWeekApproved" targetRef="ServiceTask_CompleteWorkPacks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=weekDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToLockPeriod" sourceRef="ServiceTask_CompleteWorkPacks" targetRef="ServiceTask_LockProgressPeriod" />
    <bpmn:sequenceFlow id="Flow_WeekChangesRequested" name="Changes requested: progress" sourceRef="Gateway_IsWeekApproved" targetRef="Gateway_MergeApproval" />
    <bpmn:sequenceFlow id="Flow_WeekCostReviewRequested" name="Changes requested: cost review" sourceRef="Gateway_IsWeekApproved" targetRef="Gateway_MergeReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=weekDecision = "ChangesRequested" and weekChangeTarget = "CostReview"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToPeriodLocked" sourceRef="ServiceTask_LockProgressPeriod" targetRef="EndEvent_PeriodLocked" />
    <bpmn:sequenceFlow id="Flow_ReportInvalid" sourceRef="BoundaryEvent_ReportInvalid" targetRef="Gateway_MergeReport" />
  </bpmn:process>
  <bpmn:error id="Error_ReportInvalid" name="Completion report invalid" errorCode="REPORT_INVALID" />
