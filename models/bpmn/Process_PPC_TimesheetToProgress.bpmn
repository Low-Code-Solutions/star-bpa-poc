    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=workpackNumber" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_HoursInvalid" name="Hours input invalid" errorCode="HOURS_INVALID" />
