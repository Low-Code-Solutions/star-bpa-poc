<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_WorkPackAssignment" targetNamespace="http://lowcodesol.com/star-bpa-poc" exporter="LCS generator (Claude)" exporterVersion="0.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.1">
  <bpmn:collaboration id="Collaboration_WorkPackAssignment">
    <bpmn:participant id="Participant_PPC_WorkPackAssignment" name="Work Pack Assignment (Epic 1)" processRef="Process_PPC_WorkPackAssignment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PPC_WorkPackAssignment" name="Work Pack Assignment" isExecutable="true">
    <bpmn:laneSet id="LaneSet_WorkPackAssignment">
      <bpmn:lane id="Lane_TimeMethodAnalyst" name="Time &amp; Method Analyst">
        <bpmn:flowNodeRef>StartEvent_WorkPackRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateWorkPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmWorkPack</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProjectEngineer" name="Project Engineer">
        <bpmn:flowNodeRef>UserTask_SignOffRelease</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProductionPlanner" name="Production Planner">
        <bpmn:flowNodeRef>Gateway_MergeSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ScheduleWorkPack</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProductionTeam" name="Production Team">
        <bpmn:flowNodeRef>Gateway_MergeAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_AssignmentFileReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System (POC workers)">
        <bpmn:flowNodeRef>ServiceTask_SaveWorkPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CreateHourJournalHeader</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SaveWorkPackCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_UpdateHourJournalHeader</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_EvaluateReleaseInputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BusinessRuleTask_ReleaseCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsReleaseReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordSignOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsSignOffApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SaveWorkPackSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_GenerateWorkPackPrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ValidateWorkerAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasAssignedWorkers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CreateHourJournalLines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CreateDigitalTimesheets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_WorkPackAssigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_WorkPackInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_CorrectionInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_ScheduleInvalid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_WorkPackRequested" name="Work Pack requested">
      <bpmn:documentation>Started by the Time &amp; Method Analyst from the portal through POST /api/v1/workpacks (S20, replaces the Tasklist start of D52). BPA-6.</bpmn:documentation>
      <bpmn:outgoing>Flow_ToMergeCreate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeCreate" name="">
      <bpmn:documentation>Merge: first entry or corrected input after a validation error.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeCreate</bpmn:incoming>
      <bpmn:incoming>Flow_WorkPackInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateWorkPack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_CreateWorkPack" name="Create Work Pack">
      <bpmn:documentation>BPA-6. React screen (S14; lists fetched from the backend): activity (context panel D17), drawing, materials with phase (D16), man hours per phase (D14), department (D18), date to complete (D20). Shows validationMessages after a rejected save.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="time-method-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateWorkPack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSaveWorkPack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_SaveWorkPack" name="Save Work Pack">
      <bpmn:documentation>NEW (design pack N2). Worker save-workpack: server-side validation of D14/D16/D20, generates WP-###### (D15), status Draft. Outputs workpackId, workpackNumber. Throws WORKPACK_INVALID with validationMessages. BPA-6.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-workpack" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSaveWorkPack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateHeader</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_CreateHourJournalHeader" name="Create Project Hour Journal Header">
      <bpmn:documentation>BPA-7. Upsert on workpack_id (idempotent).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-hour-journal-header" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateHeader</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeConfirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeConfirm" name="">
      <bpmn:documentation>Merge: first entry; release check Not ready (D2); Project Engineer declined (D3); correction rejected.</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeConfirm</bpmn:incoming>
      <bpmn:incoming>Flow_CorrectionInvalid</bpmn:incoming>
      <bpmn:incoming>Flow_ReleaseNotReady</bpmn:incoming>
      <bpmn:incoming>Flow_SignOffDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfirmWorkPack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ConfirmWorkPack" name="Confirm Workpack">
      <bpmn:documentation>BPA-8, BPA-23. React screen (S14): editable Draft fields (D21) plus confirmMessage (release reason or decline reason) and validationMessages.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="time-method-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirmWorkPack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSaveCorrections</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_SaveWorkPackCorrections" name="Save corrections">
      <bpmn:documentation>NEW (design pack N3). Same worker type as ServiceTask_SaveWorkPack; audits old/new values (FRD-7 §7.3.3). Throws WORKPACK_INVALID. BPA-23.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-workpack" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSaveCorrections</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUpdateHeader</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_UpdateHourJournalHeader" name="Update Project Hour Journal Header">
      <bpmn:documentation>NEW ID (design pack N4); same worker as ServiceTask_CreateHourJournalHeader (upsert). BPA-7 'Header follows corrections'.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-hour-journal-header" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUpdateHeader</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEvaluate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_EvaluateReleaseInputs" name="Evaluate release inputs">
      <bpmn:documentation>BPA-8, D24. Outputs materialsReserved, drawingApproved (D1, D10).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="evaluate-release-inputs" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEvaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReleaseCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_ReleaseCheck" name="Release check">
      <bpmn:documentation>BPA-8. Decision_WorkpackReleaseCheck (FIRST). confirmMessage = releaseReason.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_WorkpackReleaseCheck" resultVariable="releaseCheck" />
        <zeebe:ioMapping>
          <zeebe:output source="=releaseCheck.releaseResult" target="releaseResult" />
          <zeebe:output source="=releaseCheck.releaseReason" target="confirmMessage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReleaseCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToIsReleaseReady</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_IsReleaseReady" name="Release ready?" default="Flow_ReleaseNotReady">
      <bpmn:documentation>BPA-8.</bpmn:documentation>
      <bpmn:incoming>Flow_ToIsReleaseReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseReady</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReleaseNotReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_SignOffRelease" name="Sign off release">
      <bpmn:documentation>BPA-9. React screen (S14): signOffDecision Approved/Declined; declineReason required when Declined (D3), re-checked by the backend.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="project-engineer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordSignOff</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_RecordSignOff" name="Record sign-off">
      <bpmn:documentation>NEW (design pack N5). Writes release_signoff. Approved: workpack Released, Header locked (D8). Declined: confirmMessage = 'Declined by Project Engineer: &lt;reason&gt;'. BPA-9.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-release-signoff" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordSignOff</bpmn:incoming>
      <bpmn:outgoing>Flow_ToIsSignOffApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_IsSignOffApproved" name="Signed off?" default="Flow_SignOffDeclined">
      <bpmn:documentation>BPA-9.</bpmn:documentation>
      <bpmn:incoming>Flow_ToIsSignOffApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_SignOffApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignOffDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeSchedule" name="">
      <bpmn:documentation>Merge: first entry or rejected schedule.</bpmn:documentation>
      <bpmn:incoming>Flow_SignOffApproved</bpmn:incoming>
      <bpmn:incoming>Flow_ScheduleInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToScheduleWorkPack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ScheduleWorkPack" name="Schedule Work Pack">
      <bpmn:documentation>BPA-11. React screen (S14): Look-Ahead dates read-only from GET workpacks/{n}/look-ahead (D48), planned start/end, late-end notice (D26). Scheduled once (D27).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="production-planner" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScheduleWorkPack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSaveSchedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_SaveWorkPackSchedule" name="Save schedule">
      <bpmn:documentation>NEW (design pack N6). Validates lead time (D9, D28) and end &gt;= start; writes workpack_schedule. Throws SCHEDULE_INVALID. BPA-11.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-workpack-schedule" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSaveSchedule</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGeneratePrint</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_GenerateWorkPackPrint" name="Generate Workpack print">
      <bpmn:documentation>BPA-10, D4, D29, D30, S1. Idempotent on workpack_id. Sets workpack.assignment_state = AwaitingFile (D50, G7).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-workpack-print" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGeneratePrint</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeAssignment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeAssignment" name="">
      <bpmn:documentation>Merge: first entry or every row rejected (D5).</bpmn:documentation>
      <bpmn:incoming>Flow_ToMergeAssignment</bpmn:incoming>
      <bpmn:incoming>Flow_NoWorkerAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAssignmentFileReceived</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_AssignmentFileReceived" name="Assignment file received">
      <bpmn:documentation>BPA-12. Message AssignmentFileReceived, correlation key workpackNumber, TTL 0 (D62; replaces PT1H of D31/D50). Published by the assignment upload endpoint POST /api/v1/assignment-files (D58) only when assignment_state is AwaitingFile (D50). Message ID sha256:workpackNumber (G10). Carries assignmentFileId.</bpmn:documentation>
      <bpmn:incoming>Flow_ToAssignmentFileReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidateAssignment</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_AssignmentFileReceived" messageRef="Message_AssignmentFileReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask_ValidateWorkerAssignment" name="Validate and save assignment rows">
      <bpmn:documentation>BPA-22. Row checks (D14, D32, C11); writes worker_assignment and row outcomes; outputs assignedWorkerCount. Sets assignment_state = Assigning when at least one row is accepted, back to AwaitingFile when every row is rejected (D61).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-worker-assignment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateAssignment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHasAssignedWorkers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_HasAssignedWorkers" name="Any Worker assigned?" default="Flow_NoWorkerAssigned">
      <bpmn:documentation>D5: if every row is rejected, wait for a corrected file (assignment_state back to AwaitingFile, D61).</bpmn:documentation>
      <bpmn:incoming>Flow_ToHasAssignedWorkers</bpmn:incoming>
      <bpmn:outgoing>Flow_WorkersAssigned</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoWorkerAssigned</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_CreateHourJournalLines" name="Create Project Hour Journal Lines">
      <bpmn:documentation>BPA-14. Idempotent: unique(header_id, worker_id).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-hour-journal-lines" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WorkersAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateTimesheets</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_CreateDigitalTimesheets" name="Create Digital Time sheets">
      <bpmn:documentation>BPA-15. Idempotent: unique(worker_id, workpack_id). D40. Sets workpack.assignment_state = Assigned (G7).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-digital-timesheets" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateTimesheets</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_WorkPackAssigned" name="Work Pack assigned">
      <bpmn:documentation>BPA-15. Replacement (BPA-13) and Epic 2 (BPA-4) start only after this (D37).</bpmn:documentation>
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_WorkPackInvalid" name="Input invalid" attachedToRef="ServiceTask_SaveWorkPack">
      <bpmn:documentation>WORKPACK_INVALID; variables validationMessages.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=validationMessages" target="validationMessages" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_WorkPackInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_WorkPackInvalid" errorRef="Error_WorkPackInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_CorrectionInvalid" name="Correction invalid" attachedToRef="ServiceTask_SaveWorkPackCorrections">
      <bpmn:documentation>WORKPACK_INVALID; variables validationMessages.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=validationMessages" target="validationMessages" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CorrectionInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_CorrectionInvalid" errorRef="Error_WorkPackInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_ScheduleInvalid" name="Schedule invalid" attachedToRef="ServiceTask_SaveWorkPackSchedule">
      <bpmn:documentation>SCHEDULE_INVALID; variables validationMessages.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=validationMessages" target="validationMessages" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ScheduleInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ScheduleInvalid" errorRef="Error_ScheduleInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToMergeCreate" sourceRef="StartEvent_WorkPackRequested" targetRef="Gateway_MergeCreate" />
    <bpmn:sequenceFlow id="Flow_ToCreateWorkPack" sourceRef="Gateway_MergeCreate" targetRef="UserTask_CreateWorkPack" />
    <bpmn:sequenceFlow id="Flow_ToSaveWorkPack" sourceRef="UserTask_CreateWorkPack" targetRef="ServiceTask_SaveWorkPack" />
    <bpmn:sequenceFlow id="Flow_ToCreateHeader" sourceRef="ServiceTask_SaveWorkPack" targetRef="ServiceTask_CreateHourJournalHeader" />
    <bpmn:sequenceFlow id="Flow_ToMergeConfirm" sourceRef="ServiceTask_CreateHourJournalHeader" targetRef="Gateway_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_ToConfirmWorkPack" sourceRef="Gateway_MergeConfirm" targetRef="UserTask_ConfirmWorkPack" />
    <bpmn:sequenceFlow id="Flow_ToSaveCorrections" sourceRef="UserTask_ConfirmWorkPack" targetRef="ServiceTask_SaveWorkPackCorrections" />
    <bpmn:sequenceFlow id="Flow_ToUpdateHeader" sourceRef="ServiceTask_SaveWorkPackCorrections" targetRef="ServiceTask_UpdateHourJournalHeader" />
    <bpmn:sequenceFlow id="Flow_ToEvaluate" sourceRef="ServiceTask_UpdateHourJournalHeader" targetRef="ServiceTask_EvaluateReleaseInputs" />
    <bpmn:sequenceFlow id="Flow_ToReleaseCheck" sourceRef="ServiceTask_EvaluateReleaseInputs" targetRef="BusinessRuleTask_ReleaseCheck" />
    <bpmn:sequenceFlow id="Flow_ToIsReleaseReady" sourceRef="BusinessRuleTask_ReleaseCheck" targetRef="Gateway_IsReleaseReady" />
    <bpmn:sequenceFlow id="Flow_ReleaseReady" name="Ready" sourceRef="Gateway_IsReleaseReady" targetRef="UserTask_SignOffRelease">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=releaseResult = &quot;Ready&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToRecordSignOff" sourceRef="UserTask_SignOffRelease" targetRef="ServiceTask_RecordSignOff" />
    <bpmn:sequenceFlow id="Flow_ToIsSignOffApproved" sourceRef="ServiceTask_RecordSignOff" targetRef="Gateway_IsSignOffApproved" />
    <bpmn:sequenceFlow id="Flow_SignOffApproved" name="Approved" sourceRef="Gateway_IsSignOffApproved" targetRef="Gateway_MergeSchedule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signOffDecision = &quot;Approved&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToScheduleWorkPack" sourceRef="Gateway_MergeSchedule" targetRef="UserTask_ScheduleWorkPack" />
    <bpmn:sequenceFlow id="Flow_ToSaveSchedule" sourceRef="UserTask_ScheduleWorkPack" targetRef="ServiceTask_SaveWorkPackSchedule" />
    <bpmn:sequenceFlow id="Flow_ToGeneratePrint" sourceRef="ServiceTask_SaveWorkPackSchedule" targetRef="ServiceTask_GenerateWorkPackPrint" />
    <bpmn:sequenceFlow id="Flow_ToMergeAssignment" sourceRef="ServiceTask_GenerateWorkPackPrint" targetRef="Gateway_MergeAssignment" />
    <bpmn:sequenceFlow id="Flow_ToAssignmentFileReceived" sourceRef="Gateway_MergeAssignment" targetRef="IntermediateCatchEvent_AssignmentFileReceived" />
    <bpmn:sequenceFlow id="Flow_ToValidateAssignment" sourceRef="IntermediateCatchEvent_AssignmentFileReceived" targetRef="ServiceTask_ValidateWorkerAssignment" />
    <bpmn:sequenceFlow id="Flow_ToHasAssignedWorkers" sourceRef="ServiceTask_ValidateWorkerAssignment" targetRef="Gateway_HasAssignedWorkers" />
    <bpmn:sequenceFlow id="Flow_WorkersAssigned" name="Yes" sourceRef="Gateway_HasAssignedWorkers" targetRef="ServiceTask_CreateHourJournalLines">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=assignedWorkerCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToCreateTimesheets" sourceRef="ServiceTask_CreateHourJournalLines" targetRef="ServiceTask_CreateDigitalTimesheets" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="ServiceTask_CreateDigitalTimesheets" targetRef="EndEvent_WorkPackAssigned" />
    <bpmn:sequenceFlow id="Flow_WorkPackInvalid" sourceRef="BoundaryEvent_WorkPackInvalid" targetRef="Gateway_MergeCreate" />
    <bpmn:sequenceFlow id="Flow_CorrectionInvalid" sourceRef="BoundaryEvent_CorrectionInvalid" targetRef="Gateway_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_ReleaseNotReady" name="Not ready" sourceRef="Gateway_IsReleaseReady" targetRef="Gateway_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_SignOffDeclined" name="Declined" sourceRef="Gateway_IsSignOffApproved" targetRef="Gateway_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_ScheduleInvalid" sourceRef="BoundaryEvent_ScheduleInvalid" targetRef="Gateway_MergeSchedule" />
    <bpmn:sequenceFlow id="Flow_NoWorkerAssigned" name="No" sourceRef="Gateway_HasAssignedWorkers" targetRef="Gateway_MergeAssignment" />
  </bpmn:process>
  <bpmn:message id="Message_AssignmentFileReceived" name="AssignmentFileReceived">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=workpackNumber" />
